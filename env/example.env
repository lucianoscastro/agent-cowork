# Copy to env/<instance>.env (git-ignored), one file per company/account.
# Only bootstrap settings live here. Everything else (credentials, agents, projects, providers) is
# configured in the admin UI and stored in the database, with secrets encrypted.

INSTANCE_NAME=company-a

# The single admin user of this instance's UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Encrypts stored secrets and signs sessions. At least 16 characters; generate one with
#   openssl rand -base64 32
# Keep it safe: losing it makes the stored secrets unreadable (re-enter them in the UI).
AGENTCOWORK_SECRET_KEY=
